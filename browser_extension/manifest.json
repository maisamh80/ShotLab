{
  "manifest_version": 3,
  "name": "ShotLab Capture Bridge",
  "version": "0.1.3",
  "description": "Capture the visible YouTube video frame and send it directly to the running ShotLab desktop app.",
  "homepage_url": "https://github.com/maisamh80/ShotLab-Capture-Bridge",
  "minimum_chrome_version": "109",
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Capture current YouTube frame in ShotLab",
    "default_icon": {
      "16": "icons/shotlab.png",
      "32": "icons/shotlab.png",
      "48": "icons/shotlab.png",
      "128": "icons/shotlab.png"
    }
  },
  "icons": {
    "16": "icons/shotlab.png",
    "32": "icons/shotlab.png",
    "48": "icons/shotlab.png",
    "128": "icons/shotlab.png"
  }
}
